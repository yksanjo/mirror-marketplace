# Solana RPC endpoint used to verify subscription payments on-chain.
# For production, use a paid endpoint (Helius/QuickNode) — the public RPC is rate-limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Wallet that receives the platform's percentage fee on each paid subscription.
# Required for any paid tier to work. Must be a valid Solana public key.
PLATFORM_FEE_WALLET=

# Fee in basis points (500 = 5%). Default is 5% if unset.
PLATFORM_FEE_BPS=500

# Optional: where to read/write listings.json, subscriptions.json, used_signatures.json
# when running locally (no KV configured). Defaults to ./data
MARKETPLACE_DATA_DIR=

# --- Production persistence (Vercel KV / Upstash Redis) ---
# On Vercel: provision a KV store in the dashboard and the following two vars
# are auto-populated. For local dev with cloud persistence, paste them here.
# If unset, the app falls back to local JSON files in MARKETPLACE_DATA_DIR.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: mirror-deployer URL for cross-linking reputation badges on listings.
DEPLOYER_API_URL=http://127.0.0.1:3032

# --- Client-side ---
# Same RPC, exposed to the browser so the Subscribe button can build the dual-transfer tx.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Must match PLATFORM_FEE_WALLET above. The frontend uses this to construct the fee transfer.
NEXT_PUBLIC_PLATFORM_FEE_WALLET=

# Must match PLATFORM_FEE_BPS above (default 500).
NEXT_PUBLIC_PLATFORM_FEE_BPS=500
